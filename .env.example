# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth (Sign-In — identifies the viewer for the watermark)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google service account (Sheets API — reads the master spreadsheet data)
# Share the target Google Sheet with this service account's email as a Viewer.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cron
CRON_SECRET=generate-a-random-string

# Comma-separated list of emails auto-approved and made admin on first login.
# Without this you'd have no way to access the admin page on a fresh install.
BOOTSTRAP_ADMIN_EMAILS=you@company.com
